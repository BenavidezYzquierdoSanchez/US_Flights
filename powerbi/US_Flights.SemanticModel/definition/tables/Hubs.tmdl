table Hubs
	lineageTag: 4cf6bf37-d9ef-4d0e-b5ea-f7a8f8f134a0

	measure 'Vuelos hub' = SUM(Hubs[flights])
		formatString: #,0
		displayFolder: KPI
		lineageTag: 2f2a7c17-a547-4ed0-9e2e-22f3d40f7982

	measure 'OTP hub' = IF(HASONEVALUE(Hubs[code]), DIVIDE(MAX(Hubs[otp]),100))
		formatString: 0.00%
		displayFolder: KPI
		lineageTag: 915293d7-d639-47bf-8ec8-2497010714e4

	measure 'Cancelacion hub' = IF(HASONEVALUE(Hubs[code]), DIVIDE(MAX(Hubs[cancel]),100))
		formatString: 0.00%
		displayFolder: KPI
		lineageTag: a803836c-91cb-4938-bce9-c12e941727fb

	measure 'Latitud hub' = MAX(Hubs[Latitude])
		formatString: 0.0000
		displayFolder: KPI
		lineageTag: cd24093c-faa2-4e71-8723-663ccded4592

	measure 'Longitud hub' = MAX(Hubs[Longitude])
		formatString: 0.0000
		displayFolder: KPI
		lineageTag: 04ad7e9a-f54a-43f5-bf40-3d2a648692ed

