table Hubs
	lineageTag: a61c132d-266b-4f8f-9efe-8a31837650e0

	measure 'Vuelos hub' = SUM(Hubs[flights])
		formatString: #,0
		displayFolder: KPI
		lineageTag: 24046e5a-80aa-402d-9b7d-d848cfb206c3

	measure 'OTP hub' = IF(HASONEVALUE(Hubs[code]), DIVIDE(MAX(Hubs[otp]),100))
		formatString: 0.00%
		displayFolder: KPI
		lineageTag: e7a90902-62fb-401c-814e-7c8ca684fb49

	measure 'Cancelacion hub' = IF(HASONEVALUE(Hubs[code]), DIVIDE(MAX(Hubs[cancel]),100))
		formatString: 0.00%
		displayFolder: KPI
		lineageTag: aca74c84-ee68-420f-820a-fae4e746ac2a

	measure 'Latitud hub' = MAX(Hubs[Latitude])
		formatString: 0.0000
		displayFolder: KPI
		lineageTag: 64e8187a-e369-4809-bfcf-e8e45b300fc2

	measure 'Longitud hub' = MAX(Hubs[Longitude])
		formatString: 0.0000
		displayFolder: KPI
		lineageTag: 228bb4f9-ea5f-4a2e-8a0d-307a79da2b4a

