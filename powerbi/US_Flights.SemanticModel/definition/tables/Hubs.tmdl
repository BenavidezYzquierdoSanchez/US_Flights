	partition Hubs = m
		mode: import
		source =
				let Source = Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)),
				Rows = Table.FromRecords(Source),
				Typed = Table.TransformColumnTypes(Rows, {{"code", type text}, {"state", type text}, {"flights", Int64.Type}, {"otp", type number}, {"cancel", type number}, {"AirportName", type text}, {"AirportLabel", type text}, {"Latitude", type number}, {"Longitude", type number}}) in Typed

