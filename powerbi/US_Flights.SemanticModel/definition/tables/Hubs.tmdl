table Hubs
	lineageTag: 9bfd29b6-04fb-4cd5-93be-c9b8236d6ff3

	measure 'Vuelos hub' = SUM(Hubs[flights])
		formatString: #,0
		displayFolder: KPI
		lineageTag: 1a4a450e-202b-4cc8-a5ca-f59e949f6fea

	measure 'OTP hub' = IF(HASONEVALUE(Hubs[code]), DIVIDE(MAX(Hubs[otp]),100))
		formatString: 0.00%
		displayFolder: KPI
		lineageTag: d48607e8-f083-42fd-937d-2cb99209ae34

	measure 'Cancelacion hub' = IF(HASONEVALUE(Hubs[code]), DIVIDE(MAX(Hubs[cancel]),100))
		formatString: 0.00%
		displayFolder: KPI
		lineageTag: ab11cf7a-6c1d-402d-810e-5bbc53ae8b23

	measure 'Latitud hub' = MAX(Hubs[Latitude])
		formatString: 0.0000
		displayFolder: KPI
		lineageTag: 44ce594d-8e0c-4403-a51e-f9b156c1aff8

	measure 'Longitud hub' = MAX(Hubs[Longitude])
		formatString: 0.0000
		displayFolder: KPI
		lineageTag: 98360a43-afe2-45b5-8a22-2541986488e0

