table Hubs
	lineageTag: e25fbe88-9f39-4039-8d92-807bf9c34d7a

	measure 'Vuelos hub' = SUM(Hubs[flights])
		formatString: #,0
		displayFolder: KPI
		lineageTag: 7bf16390-1f62-43ae-94bc-d7070de7112d

	measure 'OTP hub' = IF(HASONEVALUE(Hubs[code]), DIVIDE(MAX(Hubs[otp]),100))
		formatString: 0.00%
		displayFolder: KPI
		lineageTag: d3924e48-fda5-4387-a50d-6e1016c239b3

	measure 'Cancelacion hub' = IF(HASONEVALUE(Hubs[code]), DIVIDE(MAX(Hubs[cancel]),100))
		formatString: 0.00%
		displayFolder: KPI
		lineageTag: 70be27a4-6e04-4e7a-9f09-1441bcaa97c4

	measure 'Latitud hub' = MAX(Hubs[Latitude])
		formatString: 0.0000
		displayFolder: KPI
		lineageTag: 5851c431-5269-409f-8b51-9a01662d5aaf

	measure 'Longitud hub' = MAX(Hubs[Longitude])
		formatString: 0.0000
		displayFolder: KPI
		lineageTag: b4646f9e-9188-4834-8c63-f4664ec7a66b

	column code
