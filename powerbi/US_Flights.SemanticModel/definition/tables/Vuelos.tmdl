table Vuelos
	lineageTag: 6713acc4-eba3-42bb-b0b1-a88d6f3442a9

	measure 'Soporte minimo' = SELECTEDVALUE(ConfiguracionSoporte[Operaciones], 30)
		formatString: #,0
		displayFolder: KPI
		lineageTag: bd59a1e4-e2eb-4205-a907-bb1927008ff0

	measure 'Meta OTP' = DIVIDE(SELECTEDVALUE(ConfiguracionOTP[Porcentaje], 80), 100)
		formatString: 0%
		displayFolder: KPI
		lineageTag: 266d227c-e8ae-4c2e-ab90-33109055dab1

	measure 'Estado OTP' = IF(ISBLANK([OTP]), "Sin datos", IF([OTP] >= [Meta OTP], "Cumple", "Bajo") & " ref. " & FORMAT([Meta OTP], "0%"))
		displayFolder: KPI
		lineageTag: 20b0c695-7426-40fb-b2b2-1a276f8e812d

	measure Operaciones = SUM(Vuelos[ops])
		formatString: #,0
		displayFolder: KPI
		lineageTag: f22ed2aa-2e00-4410-8eed-bbd5822b86e1

	measure Puntuales = SUM(Vuelos[ontime])
		formatString: #,0
		displayFolder: KPI
		lineageTag: 9f72f594-9598-4305-8e57-65a9bc48a34f

	measure 'Demorados 15' = SUM(Vuelos[delayed15])
		formatString: #,0
		displayFolder: KPI
		lineageTag: 7a99608d-f9ac-43c2-ba43-50a5473b83b6

	measure 'Demorados 60' = SUM(Vuelos[delayed60])
		formatString: #,0
		displayFolder: KPI
		lineageTag: 0087d41e-0063-433f-9aad-f679934f3a8a

	measure OTP = DIVIDE([Puntuales], [Operaciones])
		formatString: 0.00%
		displayFolder: KPI
		lineageTag: 8bec821e-6b44-4863-9e05-e982a055282c

	measure 'Tasa demora 15' = DIVIDE([Demorados 15], [Operaciones])
		formatString: 0.00%
		displayFolder: KPI
		lineageTag: cdd4fa54-72e1-4d8f-a132-0728192aaeaf

	measure 'Tasa demora 60' = DIVIDE([Demorados 60], [Operaciones])
		formatString: 0.00%
		displayFolder: KPI
		lineageTag: 548c9ed8-a207-41b0-ba16-9f364707538c

	measure 'Tasa cancelacion' = DIVIDE(SUM(Vuelos[cancel]), [Operaciones])
		formatString: 0.00%
		displayFolder: KPI
		lineageTag: fb334a0e-3869-4df8-a1ac-374abdb31a5c

	measure 'Tasa desvios' = DIVIDE(SUM(Vuelos[divert]), [Operaciones])
		formatString: 0.00%
		displayFolder: KPI
		lineageTag: de98547a-29f3-4f1c-9503-a8c3c6e93ee2

	/// Minutos acumulados de demora por operación, igual que el dashboard HTML.
	measure 'Demora media' = DIVIDE(SUM(Vuelos[sumDelayMin]), [Operaciones])
		formatString: 0.00
		displayFolder: KPI
		lineageTag: f301d67c-291e-44d2-a804-a38c16e135a6

	measure 'Sin clasificar' = SUM(Vuelos[Unclassified])
		formatString: #,0
		displayFolder: KPI
		lineageTag: 4c05a7af-c6a5-429e-8e6d-d3754103523b

	measure 'Filas causas excluidas' = COUNTROWS(FILTER(Vuelos, NOT(Vuelos[CauseValid])))
		formatString: #,0
		displayFolder: KPI
		lineageTag: 636c1163-7ce9-497e-b493-941860e34479

	measure 'Cobertura causas' = DIVIDE(CALCULATE([Operaciones], Vuelos[CauseValid] = TRUE()), [Operaciones])
		formatString: 0.00%
		displayFolder: KPI
		lineageTag: 833a66cb-02f2-4ff8-b9ab-7c41788b306a

	measure 'OTP soporte' = IF([Operaciones] >= [Soporte minimo], [OTP])
		formatString: 0.00%
		displayFolder: KPI
		lineageTag: 58e3c256-a76b-4286-99d2-811e78e3b03e

	measure 'Operaciones soporte' = IF([Operaciones] >= [Soporte minimo], [Operaciones])
		formatString: #,0
		displayFolder: KPI
		lineageTag: 616c3284-7f0a-43f3-a42e-cb65a6ba5cdb

	measure 'Cancelacion soporte' = IF([Operaciones] >= [Soporte minimo], [Tasa cancelacion])
		formatString: 0.00%
		displayFolder: KPI
		lineageTag: b5280a2f-d267-4db3-ac78-501d0b787a49

	measure 'Referencia OTP' = IF([Operaciones] > 0, [Meta OTP])
		formatString: 0.00%
		displayFolder: KPI
		lineageTag: b41dc219-52f2-46d0-909e-c939d1d0d271

	measure 'Wilson inferior' = VAR n = [Operaciones] RETURN IF(n >= [Soporte minimo] && n > 0, VAR p = [OTP] VAR z = 1.96 VAR den = 1 + z*z/n VAR c = (p + z*z/(2*n))/den VAR h = z*SQRT(p*(1-p)/n + z*z/(4*n*n))/den RETURN c-h)
		formatString: 0.00%
		displayFolder: KPI
		lineageTag: 01c23e3f-904c-41cd-beb6-99cb1391b33a

	measure 'Wilson superior' = VAR n = [Operaciones] RETURN IF(n >= [Soporte minimo] && n > 0, VAR p = [OTP] VAR z = 1.96 VAR den = 1 + z*z/n VAR c = (p + z*z/(2*n))/den VAR h = z*SQRT(p*(1-p)/n + z*z/(4*n*n))/den RETURN c+h)
		formatString: 0.00%
		displayFolder: KPI
		lineageTag: e58ecd39-cc84-4006-8c85-e4aa5a69e8ed

	measure 'Operaciones por estado' = SWITCH(SELECTEDVALUE(Estados[Estado]), "Puntuales", [Puntuales], "Demora ≥15", [Demorados 15], "Cancelados", SUM(Vuelos[cancel]), "Desviados", SUM(Vuelos[divert]), "Sin clasificar", [Sin clasificar])
		formatString: #,0
		displayFolder: KPI
		lineageTag: 4cb5bfd2-d674-4381-9bd9-21d0c91a4445

	measure 'Minutos causa' = VAR campo = SELECTEDVALUE(Causas[Campo]) RETURN SWITCH(campo, "carrierDelay", CALCULATE(SUM(Vuelos[carrierDelay]), Vuelos[CauseValid]=TRUE()), "weatherDelay", CALCULATE(SUM(Vuelos[weatherDelay]), Vuelos[CauseValid]=TRUE()), "nasDelay", CALCULATE(SUM(Vuelos[nasDelay]), Vuelos[CauseValid]=TRUE()), "secDelay", CALCULATE(SUM(Vuelos[secDelay]), Vuelos[CauseValid]=TRUE()), "lateAirDelay", CALCULATE(SUM(Vuelos[lateAirDelay]), Vuelos[CauseValid]=TRUE()))
		formatString: #,0
		displayFolder: KPI
		lineageTag: 7e94efe7-c95f-4835-9aab-64acb538e873

	measure 'Total minutos conciliados' = SUMX(ALL(Causas), [Minutos causa])
		formatString: #,0
		displayFolder: KPI
		lineageTag: e20b31cb-6de6-401a-8734-487e4831d686

	measure 'Lectura annual' =
			VAR tab = FILTER(ADDCOLUMNS(VALUES(Calendario[Year]), "pct", [OTP]), NOT ISBLANK([pct]))
			VAR hi = TOPN(1, tab, [pct], DESC, Calendario[Year], ASC)
			VAR lo = TOPN(1, tab, [pct], ASC, Calendario[Year], ASC)
			RETURN "Variables: Year; ops (barras); ontime / ops (%) (línea). Propósito: Barras y línea comparan volumen y nivel de servicio en ejes distintos. Comparar períodos equivalentes: 2026 termina en mayo. Interpretación: " & (IF([Operaciones]=0, "Sin datos para el filtro.", "Mayor OTP: " & CONCATENATEX(hi, Calendario[Year] & " (" & FORMAT([pct], "0.00%") & ")") & "; menor: " & CONCATENATEX(lo, Calendario[Year] & " (" & FORMAT([pct], "0.00%") & ")") & ". Revisar períodos bajos. Comparar coberturas equivalentes: 2026 termina en mayo."))
		displayFolder: Interpretaciones
		lineageTag: c4ea3d63-b16a-4c48-b54a-010feb3c8e74

	measure 'Lectura mix' = RETURN "Variables: ontime, delayed15, cancel, divert, Unclassified (conteos). Propósito: La dona representa proporciones de categorías excluyentes y conserva el residuo sin clasificar. delayed60 es subconjunto de delayed15. Interpretación: " & (IF([Operaciones]=0, "Sin datos para el filtro.", "Puntualidad: " & FORMAT([OTP], "0.00%") & "; operaciones sin categoría: " & FORMAT([Sin clasificar], "#,0") & ". Conservar el residuo y revisar incidencias; demora >=60 es parte de >=15."))
		displayFolder: Interpretaciones
		lineageTag: d2a2627a-ca2b-4cb8-b25a-39708aa59144

	measure 'Lectura haul' =
			VAR tab = FILTER(ADDCOLUMNS(VALUES(Radios[Haul]), "pct", [OTP], "n", [Operaciones]), [n]>=[Soporte minimo])
			VAR hi = TOPN(1, tab, [pct], DESC, Radios[Haul], ASC)
			VAR lo = TOPN(1, tab, [pct], ASC, Radios[Haul], ASC)
			RETURN "Variables: Haul (categoría); ontime / ops (%). Propósito: Comparar radios orienta la asignación de recursos; los límites de distancia del radio no están documentados en el JSON. Interpretación: " & (IF(COUNTROWS(tab)=0,"Sin categorías con el soporte seleccionado.", "Mayor OTP: " & CONCATENATEX(hi, Radios[Haul] & " (" & FORMAT([pct], "0.00%") & ", N=" & FORMAT([n],"#,0") & ")") & "; menor: " & CONCATENATEX(lo, Radios[Haul] & " (" & FORMAT([pct], "0.00%") & ")") & ". Priorizar diagnóstico. La comparación no controla la mezcla de rutas y períodos ni demuestra causalidad."))
		displayFolder: Interpretaciones
		lineageTag: 3839290a-391e-4ee4-9157-c1c60f04ecae

	measure 'Lectura timeline' =
			VAR tab = FILTER(ADDCOLUMNS(VALUES(Calendario[Period]), "pct", [OTP]), NOT ISBLANK([pct]))
			VAR hi = TOPN(1, tab, [pct], DESC, Calendario[Period], ASC)
			VAR lo = TOPN(1, tab, [pct], ASC, Calendario[Period], ASC)
			RETURN "Variables: Year-Month; ontime / ops (%). Propósito: El orden cronológico distingue cambios en el tiempo. Los meses sin observación son huecos, nunca ceros. Interpretación: " & (IF([Operaciones]=0, "Sin datos para el filtro.", "Mayor OTP: " & CONCATENATEX(hi, Calendario[Period] & " (" & FORMAT([pct], "0.00%") & ")") & "; menor: " & CONCATENATEX(lo, Calendario[Period] & " (" & FORMAT([pct], "0.00%") & ")") & ". Revisar períodos bajos. Comparar coberturas equivalentes: 2026 termina en mayo."))
		displayFolder: Interpretaciones
		lineageTag: 32edcfb9-ef3c-4a69-9f37-7e8f781393e3

	measure 'Lectura season' =
			VAR tab = FILTER(ADDCOLUMNS(VALUES(Calendario[MonthName]), "pct", [OTP]), NOT ISBLANK([pct]))
			VAR hi = TOPN(1, tab, [pct], DESC, Calendario[MonthName], ASC)
			VAR lo = TOPN(1, tab, [pct], ASC, Calendario[MonthName], ASC)
			RETURN "Variables: Year, Month; ops; Σontime / Σops; cancel / ops (%). Propósito: Las curvas comparan los años por mes; con un año seleccionado se combina volumen, OTP y cancelación. La composición de aerolíneas y la cobertura pueden cambiar. Interpretación: " & (IF([Operaciones]=0, "Sin datos para el filtro.", "Mayor OTP: " & CONCATENATEX(hi, Calendario[MonthName] & " (" & FORMAT([pct], "0.00%") & ")") & "; menor: " & CONCATENATEX(lo, Calendario[MonthName] & " (" & FORMAT([pct], "0.00%") & ")") & ". Revisar períodos bajos. Comparar coberturas equivalentes: 2026 termina en mayo."))
		displayFolder: Interpretaciones
		lineageTag: 4e9fa846-25e7-4c10-b5c7-881283c817ec

	measure 'Lectura uncertainty' =
			VAR tab = FILTER(ADDCOLUMNS(VALUES(Aerolineas[AirlineLabel]), "pct", [OTP], "n", [Operaciones]), [n]>=[Soporte minimo])
			VAR hi = TOPN(1, tab, [pct], DESC, Aerolineas[AirlineLabel], ASC)
			VAR lo = TOPN(1, tab, [pct], ASC, Aerolineas[AirlineLabel], ASC)
			RETURN "Variables: Airline; ontime; ops; límite inferior y superior (%). Propósito: Las barras de error expresan precisión bajo un modelo binomial. No cuantifican sesgo ni dependencia entre vuelos. Interpretación: " & (IF(COUNTROWS(tab)=0,"Sin categorías con el soporte seleccionado.", "Mayor OTP: " & CONCATENATEX(hi, Aerolineas[AirlineLabel] & " (" & FORMAT([pct], "0.00%") & ", N=" & FORMAT([n],"#,0") & ")") & "; menor: " & CONCATENATEX(lo, Aerolineas[AirlineLabel] & " (" & FORMAT([pct], "0.00%") & ")") & ". Priorizar diagnóstico. Wilson 95% supone independencia binomial; no cuantifica sesgo ni dependencia."))
		displayFolder: Interpretaciones
		lineageTag: b616a57d-a85c-4b8f-85c1-ba5c9864c878

	measure 'Lectura hourly' = VAR tab=ADDCOLUMNS(VALUES(Horarios[hour_block]),"mins",CALCULATE(MAX(Horarios[avg_delay]))) VAR hi=TOPN(1,tab,[mins],DESC,Horarios[hour_block],ASC) VAR lo=TOPN(1,tab,[mins],ASC,Horarios[hour_block],ASC) RETURN "Variables: hour_block (hora); avg_delay (minutos). Propósito: La línea compara el resumen horario suministrado. No hay conteos ni claves para ponderarlo o filtrarlo con el cubo. Interpretación: " & ("Mínimo horario: " & CONCATENATEX(lo,FORMAT(Horarios[hour_block],"00") & ":00, " & FORMAT([mins],"0.0") & " min") & "; máximo: " & CONCATENATEX(hi,FORMAT(Horarios[hour_block],"00") & ":00, " & FORMAT([mins],"0.0") & " min") & ". Resumen global: no tiene denominador ni período y no demuestra efecto cascada.")
		displayFolder: Interpretaciones
		lineageTag: 0860ba19-2527-4671-a968-395f1a4ff763

	measure 'Lectura map' = VAR tab=ADDCOLUMNS(VALUES(Hubs[AirportLabel]),"pct",CALCULATE(MAX(Hubs[otp]))) VAR lo=TOPN(1,tab,[pct],ASC,Hubs[AirportLabel],ASC) RETURN "Variables: Latitud, longitud (coordenadas); otp (%); flights (conteo). Propósito: La ubicación permite explorar concentraciones espaciales. Son aeropuertos seleccionados; no se deriva un mapa estatal. Interpretación: " & ("Menor OTP del resumen mostrado: " & CONCATENATEX(lo,Hubs[AirportLabel] & " (" & FORMAT([pct]/100,"0.00%") & ")") & ". Priorizar diagnóstico con volumen y cancelación. Resumen independiente sin fecha ni aerolínea; los filtros del cubo no se aplican.")
		displayFolder: Interpretaciones
		lineageTag: 5f0d2d62-ebf3-4ae1-a79c-b918f96dbbce

	measure 'Lectura hubs' = VAR tab=ADDCOLUMNS(VALUES(Hubs[AirportLabel]),"pct",CALCULATE(MAX(Hubs[otp]))) VAR lo=TOPN(1,tab,[pct],ASC,Hubs[AirportLabel],ASC) RETURN "Variables: flights (X); otp (Y, %); cancel (tamaño, %). Propósito: La dispersión compara escala y servicio; el área de burbuja aumenta con la tasa de cancelación. Interpretación: " & ("Menor OTP del resumen mostrado: " & CONCATENATEX(lo,Hubs[AirportLabel] & " (" & FORMAT([pct]/100,"0.00%") & ")") & ". Priorizar diagnóstico con volumen y cancelación. Resumen independiente sin fecha ni aerolínea; los filtros del cubo no se aplican.")
		displayFolder: Interpretaciones
		lineageTag: 115524b6-bcf1-426d-bb84-49e118df6d58

	measure 'Lectura tradeoff' =
			VAR tab = FILTER(ADDCOLUMNS(VALUES(Aerolineas[AirlineLabel]), "pct", [OTP], "n", [Operaciones]), [n]>=[Soporte minimo])
			VAR hi = TOPN(1, tab, [pct], DESC, Aerolineas[AirlineLabel], ASC)
			VAR lo = TOPN(1, tab, [pct], ASC, Aerolineas[AirlineLabel], ASC)
			RETURN "Variables: Airline; ops (X); OTP (Y, %); cancelRate (tamaño, %). Propósito: Permite localizar operadores con gran exposición y menor puntualidad. Una asociación no demuestra causalidad. Interpretación: " & (IF(COUNTROWS(tab)=0,"Sin categorías con el soporte seleccionado.", "Mayor OTP: " & CONCATENATEX(hi, Aerolineas[AirlineLabel] & " (" & FORMAT([pct], "0.00%") & ", N=" & FORMAT([n],"#,0") & ")") & "; menor: " & CONCATENATEX(lo, Aerolineas[AirlineLabel] & " (" & FORMAT([pct], "0.00%") & ")") & ". Priorizar diagnóstico. La comparación no controla la mezcla de rutas y períodos ni demuestra causalidad."))
		displayFolder: Interpretaciones
		lineageTag: 155e0d8a-f78d-486f-bfa7-4fdbddd2433c

	measure 'Lectura ranking' =
			VAR tab = FILTER(ADDCOLUMNS(VALUES(Aerolineas[AirlineLabel]), "pct", [OTP], "n", [Operaciones]), [n]>=[Soporte minimo])
			VAR hi = TOPN(1, tab, [pct], DESC, Aerolineas[AirlineLabel], ASC)
			VAR lo = TOPN(1, tab, [pct], ASC, Aerolineas[AirlineLabel], ASC)
			RETURN "Variables: Airline (categoría); Σontime / Σops (%). Propósito: Las barras ordenadas facilitan comparaciones. Son tasas ponderadas por operaciones; no promedios simples de porcentajes. Interpretación: " & (IF(COUNTROWS(tab)=0,"Sin categorías con el soporte seleccionado.", "Mayor OTP: " & CONCATENATEX(hi, Aerolineas[AirlineLabel] & " (" & FORMAT([pct], "0.00%") & ", N=" & FORMAT([n],"#,0") & ")") & "; menor: " & CONCATENATEX(lo, Aerolineas[AirlineLabel] & " (" & FORMAT([pct], "0.00%") & ")") & ". Priorizar diagnóstico. La comparación no controla la mezcla de rutas y períodos ni demuestra causalidad."))
		displayFolder: Interpretaciones
		lineageTag: 8c34196c-13b2-4ceb-92f9-7b23b81faee2

	measure 'Lectura causes' = VAR tab = ADDCOLUMNS(ALL(Causas), "mins", [Minutos causa]) VAR topcause=TOPN(1,tab,[mins],DESC,Causas[Causa],ASC) RETURN "Variables: carrierDelay, weatherDelay, nasDelay, secDelay, lateAirDelay (minutos). Propósito: Comparar minutos identifica focos de intervención en el subconjunto consistente. Se excluyen filas cuya suma de causas no coincide con sumDelayMin (tolerancia 1 minuto). Interpretación: " & (IF([Total minutos conciliados]=0,"Sin minutos por causa conciliados.","Causa dominante: " & CONCATENATEX(topcause,Causas[Causa] & " (" & FORMAT(DIVIDE([mins],[Total minutos conciliados]),"0.00%") & ")") & ". Priorizar su diagnóstico. Filas excluidas: " & FORMAT([Filas causas excluidas],"#,0") & "; cobertura de operaciones: " & FORMAT([Cobertura causas],"0.00%") & ". Hallazgo del subconjunto conciliado."))
		displayFolder: Interpretaciones
		lineageTag: c3ddd139-abdf-43fd-83c5-92a823d7195c

