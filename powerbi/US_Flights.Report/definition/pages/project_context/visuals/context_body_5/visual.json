                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Evaluar políticas de conexiones y rotación · Perfil horario global y OTP por radio, analizados por separado · No establecer conexiones mínimas de 45 minutos ni un corte a las 15:00: falta el cruce hora × radio × conexión.",
                    "textStyle": {
                      "fontSize": "12pt",
                      "fontFamily": "Segoe UI",
